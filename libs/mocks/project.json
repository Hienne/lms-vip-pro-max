{
  "name": "mocks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mocks/src",
  "projectType": "library",
  "tags": ["type:mocks"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc --noEmit -p libs/mocks/tsconfig.lib.json",
          "tsc --noEmit -p libs/mocks/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
