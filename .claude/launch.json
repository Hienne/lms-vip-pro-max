{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lms",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "source ~/.nvm/nvm.sh && nvm use 24 >/dev/null && npx nx serve lms --port 4200"
      ],
      "port": 4200
    },
    {
      "name": "lms-local-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "source ~/.nvm/nvm.sh && nvm use 24 >/dev/null && LMS_API_TARGET=http://localhost:8019 npx nx serve lms --port 4200"
      ],
      "port": 4200
    },
    {
      "name": "community-mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4310",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/mockups/community"
      ],
      "port": 4310
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd ~/my-projects/corebanking-academy && mvn -q spring-boot:run"
      ],
      "port": 8019
    }
  ]
}
